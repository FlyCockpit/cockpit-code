{
  "rust": {"command":"rust-analyzer","args":[],"fileGlobs":["*.rs"],"rootMarkers":["Cargo.toml","rust-project.json",".git"],"install":"rustup component add rust-analyzer"},
  "typescript": {"command":"typescript-language-server","args":["--stdio"],"fileGlobs":["*.ts","*.tsx","*.js","*.jsx","*.mts","*.cts","*.mjs","*.cjs"],"rootMarkers":["tsconfig.json","jsconfig.json","package.json",".git"],"install":"npm install -g typescript typescript-language-server"},
