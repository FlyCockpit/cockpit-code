  "go": {"command":"gopls","args":[],"fileGlobs":["*.go"],"rootMarkers":["go.work","go.mod",".git"],"install":"go install golang.org/x/tools/gopls@latest"},
  "cpp": {"command":"clangd","args":["--background-index=false"],"fileGlobs":["*.c","*.h","*.cc","*.hh","*.cpp","*.hpp","*.cxx","*.hxx"],"rootMarkers":["compile_commands.json","compile_flags.txt","CMakeLists.txt",".git"],"install":"Install LLVM/clangd using your system package manager"}
